import { useRef, useEffect, useCallback } from 'react';
export function useAbortableFetch() {
  const ctrls = useRef<Set<AbortController>>(new Set());
  const fetcher = useCallback(async (input: RequestInfo, init?: RequestInit) => {
    const c = new AbortController(); ctrls.current.add(c);
    try { return await fetch(input, { ...init, signal: c.signal }); } finally { ctrls.current.delete(c); }
  }, []);
  useEffect(() => () => { ctrls.current.forEach(c => c.abort()); ctrls.current.clear(); }, []);
  return fetcher;
}
