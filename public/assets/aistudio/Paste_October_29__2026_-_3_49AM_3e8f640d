export class RouterGuard {
  private static circuit = new Map<string, boolean>();
  private static failures = new Map<string, number>();
  private static lastCheck = new Map<string, number>();
  private static cachedCpu = new Map<string, number>();
  static async canProceed(token: string, forceCheck = false): Promise<{ ok: boolean; reason?: string; cpu?: number }> {
    if (this.circuit.get(token)) return { ok: false, reason: 'الدائرة مفتوحة مؤقتاً — الراوتر تحت ضغط سابق' };
    const now = Date.now();
    if (forceCheck || now - (this.lastCheck.get(token) || 0) > 10_000) {
      try {
        const res = await fetch('/api/vouchers/precheck', { headers: { 'X-Router-Token': token } });
        const data = await res.json();
        this.lastCheck.set(token, now);
        const cpu = data?.data?.routerInfo?.cpuLoad ?? 0;
        const freeMem = data?.data?.routerInfo?.freeMemory ?? Infinity;
        this.cachedCpu.set(token, cpu);
        if (cpu > 80) { this.circuit.set(token, true); setTimeout(() => this.circuit.set(token, false), 30_000); return { ok: false, reason: `CPU ${cpu}% — تأجيل الحقن`, cpu }; }
        if (freeMem < 5 * 1024 * 1024) return { ok: false, reason: 'ذاكرة الراوتر منخفضة', cpu };
      } catch { return { ok: true, cpu: this.cachedCpu.get(token) || 0 }; }
    }
    return { ok: true, cpu: this.cachedCpu.get(token) || 0 };
  }
  static recordSuccess(token: string): void { this.failures.set(token, 0); }
  static recordFailure(token: string): void { const f = (this.failures.get(token) || 0) + 1; this.failures.set(token, f); if (f >= 3) this.circuit.set(token, true); }
  static reset(token: string): void { this.circuit.delete(token); this.failures.delete(token); this.lastCheck.delete(token); this.cachedCpu.delete(token); }
}
