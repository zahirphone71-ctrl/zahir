{
  "name": "zctrl",
  "private": true,
  "version": "1.0.0",
  "description": "ZCtrl - نظام إدارة سيرفرات المايكروتك وطباعة الكروت",
  "author": "ZCtrl Team",
  "main": "electron-main.cjs",
  "type": "module",
  "build": {
    "appId": "com.zctrl.mikrotik",
    "productName": "ZCtrl",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json",
      "build/**/*",
      "public/**/*",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZCtrl",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico"
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "generate:icons": "node scripts/generate-icons.js",
    "build": "node --max-old-space-size=4096 scripts/build.js",
    "build:win": "node --max-old-space-size=4096 scripts/build-win.js",
    "build:exe": "node --max-old-space-size=4096 scripts/build-win.js",
    "electron:start": "electron electron-main.cjs",
    "electron:build": "node --max-old-space-size=4096 scripts/build-win.js",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "audit:ai": "node scripts/ai_audit.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@types/sql.js": "^1.4.11",
    "basic-ftp": "^6.2.6",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "4.22.3",
    "express-rate-limit": "^8.7.0",
    "fast-deep-equal": "^3.1.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sql.js": "^1.15.0",
    "uuid": "^14.0.2",
    "ws": "^8.18.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "body-parser": "^1.20.9",
    "qs": "^6.17.1",
    "dompurify": "^3.5.0",
    "ip-address": "^10.7.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}